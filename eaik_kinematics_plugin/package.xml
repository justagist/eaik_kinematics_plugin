<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eaik_kinematics_plugin</name>
  <version>0.1.0</version>
  <description>MoveIt kinematics plugin that solves inverse kinematics in closed form with EAIK.</description>
  <maintainer email="mail@saifsidhik.page">Saif Sidhik</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eaik_vendor</depend>
  <depend>eigen</depend>
  <depend>generate_parameter_library</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>moveit_kinematics</test_depend>
  <test_depend>moveit_resources_fanuc_description</test_depend>
  <test_depend>moveit_resources_fanuc_moveit_config</test_depend>
  <test_depend>moveit_resources_panda_description</test_depend>
  <test_depend>moveit_resources_panda_moveit_config</test_depend>
  <test_depend>srdfdom</test_depend>
  <test_depend>tf2_eigen</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
